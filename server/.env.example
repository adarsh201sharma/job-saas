# ── Server ────────────────────────────────────────────────────────────────────
# Railway injects PORT automatically — do NOT set it manually in Railway
PORT=8000
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
# https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=7d

# ── AI APIs ───────────────────────────────────────────────────────────────────
# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# ── Job Search ────────────────────────────────────────────────────────────────
# JSearch via RapidAPI — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your deployed frontend URL (e.g. https://yourapp.vercel.app)
CLIENT_URL=https://your-frontend-url.com
